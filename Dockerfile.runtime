FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p jenkins-runtime --bin jenkins-mcp

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/jenkins-mcp /usr/local/bin/jenkins-mcp
COPY schemas ./schemas
ENTRYPOINT ["jenkins-mcp"]
CMD ["--package", "/package"]
