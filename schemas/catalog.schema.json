{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmji/jenkins-knowledge/schemas/catalog.schema.json",
  "title": "Jenkins Knowledge Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "generatedAt",
    "sources",
    "symbols"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Catalog schema version. Version 1 is 1.0.0."
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "coverage": {
      "type": "array",
      "description": "Collection coverage, separate from symbol confidence and source provenance.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "surface",
          "status"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "inspected",
              "succeeded",
              "succeeded-with-truncation",
              "partial",
              "unavailable",
              "permission-denied",
              "failed",
              "skipped-by-profile",
              "not-configured",
              "unsupported",
              "not-collected"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "controller": {
      "$ref": "#/$defs/controller",
      "description": "Optional controller-specific runtime snapshot. Omitted for catalogs without controller discovery."
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Stable SHA-256 identity of the canonical logical catalog snapshot; collection timestamps are excluded."
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "optional-source-unavailable",
              "permission-denied",
              "source-failed",
              "source-truncated",
              "source-skipped",
              "source-not-configured"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reasonCodes"
            ],
            "properties": {
              "reasonCodes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "jenkins-controller",
            "plugin",
            "shared-library",
            "jenkins-core"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "metadata": {
          "type": "object"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Canonical SHA-256 of the source snapshot, associated symbols, coverage, and controller/plugin observations."
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "status",
            "truncated"
          ],
          "properties": {
            "profile": {
              "enum": [
                "quick",
                "standard",
                "deep",
                "custom"
              ]
            },
            "status": {
              "enum": [
                "succeeded",
                "succeeded-with-truncation",
                "partial",
                "unavailable",
                "permission-denied",
                "failed",
                "skipped-by-profile",
                "not-configured",
                "unknown"
              ]
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            },
            "errorCode": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string"
        },
        "default": {}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "sourceId",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "step",
            "global-variable",
            "method",
            "class",
            "property",
            "declarative-directive"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "extensionCategory": {
          "enum": [
            "agent",
            "option",
            "when",
            "post-condition",
            "trigger",
            "parameter"
          ]
        },
        "nameKind": {
          "enum": [
            "dsl-token",
            "implementation-class"
          ]
        },
        "descriptorClass": {
          "type": "string",
          "minLength": 1
        },
        "stageOnly": {
          "type": "boolean"
        },
        "canUseInStage": {
          "type": "boolean"
        },
        "allowedChildrenCount": {
          "type": "integer",
          "minimum": -1,
          "maximum": 100
        },
        "invisible": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "returnType": {
          "type": "string"
        },
        "readable": {"type": "boolean"},
        "writable": {"type": "boolean"},
        "modifiers": {"type": "string"},
        "synthetic": {"type": "boolean"},
        "superclass": {"type": "string"},
        "interfaces": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
        "overloads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentationUrl": {
          "type": "string",
          "format": "uri"
        },
        "confidence": {
          "enum": [
            "verified",
            "inferred",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fieldEvidence": {
          "type": "object",
          "description": "Per-field evidence quality; omitted fields remain unknown, not verified.",
          "additionalProperties": {
            "enum": [
              "verified",
              "inferred",
              "unknown"
            ]
          }
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "executionConstraints": {
          "$ref": "#/$defs/executionConstraints"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "coreVersion",
        "plugins",
        "capabilities",
        "collection"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "coreVersion": {
          "type": "string",
          "minLength": 1
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controllerPlugin"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "collection": {
          "$ref": "#/$defs/collection"
        },
        "runtime": {
          "$ref": "#/$defs/controllerRuntime"
        }
      }
    },
    "controllerPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "shortName",
        "version",
        "enabled",
        "active",
        "dependencies"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginDependency"
          }
        }
      }
    },
    "pluginDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortName"
      ],
      "properties": {
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "minimumVersion": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "details": {
          "type": "string"
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "retrievedAt"
      ],
      "properties": {
        "profile": {
          "enum": [
            "quick",
            "standard",
            "deep",
            "custom"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "pluginSourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cps": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown",
            "not-inspected"
          ]
        },
        "sandbox": {
          "enum": [
            "approved",
            "rejected",
            "unknown",
            "not-inspected"
          ]
        },
        "contexts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pluginDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "kind",
        "confidence",
        "retrievedAt"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "controller-observed",
            "source-scanned",
            "static-model",
            "inferred"
          ]
        },
        "confidence": {
          "enum": [
            "verified",
            "inferred",
            "unknown"
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Source revision to which this evidence record applies."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "description": "Location within the source snapshot, such as endpoint/probe or file path."
        },
        "sourceKind": {
          "enum": [
            "jenkins-controller",
            "jenkins-core",
            "shared-library",
            "plugin"
          ]
        }
      }
    },
    "controllerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "templateVersion",
        "source",
        "status",
        "collectedAt",
        "extensionRegistries",
        "errors"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "templateVersion": {
          "const": "2"
        },
        "source": {
          "const": "script-console"
        },
        "status": {
          "enum": [
            "collected",
            "partial",
            "unavailable"
          ]
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "groovyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "javaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "javaVendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "jenkinsCoreVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extensionRegistries": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/controllerExtensionRegistry"
          }
        },
        "apiTypes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "synthetic", "methods", "properties"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 256},
              "kind": {"enum": ["class", "interface", "enum"]},
              "superclass": {"type": "string", "maxLength": 256},
              "interfaces": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 256}},
              "modifiers": {"type": "string", "maxLength": 128},
              "synthetic": {"type": "boolean"},
              "methodsTruncated": {"type": "boolean"},
              "propertiesTruncated": {"type": "boolean"},
              "plugin": {"type": "string", "maxLength": 256},
              "methods": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "synthetic"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 256},
                    "signature": {"type": "string", "maxLength": 2048},
                    "returnType": {"type": "string", "maxLength": 256},
                    "parameterTypes": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 256}},
                    "modifiers": {"type": "string", "maxLength": 128},
                    "synthetic": {"type": "boolean"}
                  }
                }
              },
              "properties": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "readable", "writable"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 256},
                    "readable": {"type": "boolean"},
                    "writable": {"type": "boolean"}
                  }
                }
              }
            }
          }
        },
        "apiTypesTruncated": {"type": "boolean"},
        "errors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/controllerRuntimeError"
          }
        }
      }
    },
    "controllerExtensionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "items",
        "truncated"
      ],
      "properties": {
        "name": {
          "enum": [
            "pipeline-steps",
            "pipeline-globals",
            "declarative-extensions"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "className"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "className": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "plugin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "parameters": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/parameter"
                }
              },
              "parametersTruncated": {
                "type": "boolean"
              },
              "category": {
                "enum": [
                  "agent",
                  "option",
                  "when",
                  "post-condition",
                  "trigger",
                  "parameter"
                ]
              },
              "nameKind": {
                "enum": [
                  "dsl-token",
                  "implementation-class"
                ]
              },
              "descriptorClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "apiTypeRoot": {"type": "string", "minLength": 1, "maxLength": 256},
              "contexts": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 2,
                "items": {
                  "enum": ["pipeline", "stage"]
                }
              },
              "stageOnly": {
                "type": "boolean"
              },
              "canUseInStage": {
                "type": "boolean"
              },
              "allowedChildrenCount": {
                "type": "integer",
                "minimum": -1,
                "maximum": 100
              },
              "invisible": {
                "type": "boolean"
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "controllerRuntimeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe",
        "code"
      ],
      "properties": {
        "probe": {
          "enum": [
            "script-console",
            "groovy-version",
            "java-version",
            "java-vendor",
            "jenkins-core-version",
            "pipeline-steps",
            "pipeline-globals",
            "declarative-extensions",
            "output"
          ]
        },
        "code": {
          "enum": [
            "credentials-must-be-paired",
            "invalid-controller-url",
            "request-timeout",
            "request-failed",
            "permission-denied",
            "endpoint-unavailable",
            "http-error",
            "response-too-large",
            "invalid-response",
            "incompatible-probe-output",
            "probe-failed",
            "jenkins-unavailable",
            "extension-type-unavailable",
            "enumeration-failed",
            "output-truncated"
          ]
        }
      }
    }
  }
}
