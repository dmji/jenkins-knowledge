{
  "name": "jenkins-knowledge",
  "displayName": "Jenkins Knowledge",
  "description": "Jenkins Pipeline and Shared Library completion backed by a Knowledge Package.",
  "version": "0.1.0",
  "publisher": "dmji",
  "packageManager": "npm@11.20.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:groovy",
    "onCommand:jenkinsKnowledge.reload"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.8.2",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "jenkinsKnowledge.reload",
        "title": "Jenkins Knowledge: Reload Knowledge Package"
      }
    ],
    "configuration": {
      "title": "Jenkins Knowledge",
      "properties": {
        "jenkinsKnowledge.serverPath": {
          "type": "string",
          "default": "jenkins-lsp",
          "description": "Path to the compiled jenkins-lsp executable."
        },
        "jenkinsKnowledge.packagePath": {
          "type": "string",
          "default": "",
          "description": "Path to a built Knowledge Package, relative to the workspace or absolute."
        },
        "jenkinsKnowledge.profile": {
          "type": "string",
          "default": "",
          "description": "Expected package profile. A mismatch disables catalog results."
        }
      }
    }
  }
}
