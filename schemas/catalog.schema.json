{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmji/jenkins-knowledge/schemas/catalog.schema.json",
  "title": "Jenkins Knowledge Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "generatedAt",
    "sources",
    "symbols"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Catalog schema version. Version 1 is 1.0.0."
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "coverage": {
      "type": "array",
      "description": "Collection coverage, separate from symbol confidence and source provenance.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "surface",
          "status"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "inspected",
              "unavailable",
              "unsupported",
              "not-collected"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "controller": {
      "$ref": "#/$defs/controller",
      "description": "Optional controller-specific runtime snapshot. Omitted for catalogs without controller discovery."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "jenkins-controller",
            "plugin",
            "shared-library",
            "jenkins-core"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string"
        },
        "default": {}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "sourceId",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "step",
            "global-variable",
            "method",
            "class",
            "property",
            "declarative-directive"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "returnType": {
          "type": "string"
        },
        "overloads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentationUrl": {
          "type": "string",
          "format": "uri"
        },
        "confidence": {
          "enum": [
            "verified",
            "inferred",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fieldEvidence": {
          "type": "object",
          "description": "Per-field evidence quality; omitted fields remain unknown, not verified.",
          "additionalProperties": {
            "enum": [
              "verified",
              "inferred",
              "unknown"
            ]
          }
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "executionConstraints": {
          "$ref": "#/$defs/executionConstraints"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "coreVersion",
        "plugins",
        "capabilities",
        "collection"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "coreVersion": {
          "type": "string",
          "minLength": 1
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controllerPlugin"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "collection": {
          "$ref": "#/$defs/collection"
        }
      }
    },
    "controllerPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "shortName",
        "version",
        "enabled",
        "active",
        "dependencies"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pluginDependency"
          }
        }
      }
    },
    "pluginDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortName"
      ],
      "properties": {
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "minimumVersion": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "details": {
          "type": "string"
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "retrievedAt"
      ],
      "properties": {
        "profile": {
          "enum": [
            "quick",
            "standard",
            "deep",
            "custom"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "pluginSourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cps": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown",
            "not-inspected"
          ]
        },
        "sandbox": {
          "enum": [
            "approved",
            "rejected",
            "unknown",
            "not-inspected"
          ]
        },
        "contexts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pluginDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "kind",
        "confidence",
        "retrievedAt"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "controller-observed",
            "source-scanned",
            "static-model",
            "inferred"
          ]
        },
        "confidence": {
          "enum": [
            "verified",
            "inferred",
            "unknown"
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
