FROM ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b AS runtime-base
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS runtime
RUN groupadd --system --gid 10001 runtime \
    && useradd --system --uid 10001 --gid runtime --home-dir /nonexistent --no-create-home runtime \
    && mkdir -p /package \
    && chown runtime:runtime /package
COPY --chown=root:root --chmod=0555 target/release/jenkins-runtime /usr/local/bin/jenkins-runtime
COPY --chown=root:root --chmod=0555 target/release/jenkins-mcp /usr/local/bin/jenkins-mcp
COPY --chown=root:root --chmod=0555 target/release/groovy-stubs /usr/local/bin/groovy-stubs
COPY --chown=root:root --chmod=0555 target/release/jenkins-lsp /usr/local/bin/jenkins-lsp
WORKDIR /package
USER runtime:runtime
ENTRYPOINT ["jenkins-runtime"]
CMD ["--package", "/package"]
